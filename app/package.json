{
  "name": "@texeris/app",
  "version": "0.1.0",
  "private": true,
  "description": "Texeris — revision-aware academic writing workspace",
  "author": "bair82",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "prepare:pandoc": "node scripts/prepare-pandoc.mjs",
    "dist": "pnpm run prepare:pandoc && electron-vite build && electron-builder",
    "dist:linux": "pnpm run prepare:pandoc && electron-vite build && electron-builder --linux",
    "smoke": "pnpm run smoke:offline",
    "smoke:offline": "node scripts/smoke-all.mjs",
    "smoke:main": "node scripts/smoke.mjs",
    "smoke:citations": "node scripts/smoke-citations.mjs",
    "smoke:archive": "node scripts/smoke-archive.mjs",
    "smoke:platform": "node scripts/smoke-settings.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "parse5": "8.0.0",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@types/diff": "^8.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "diff": "^9.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
